{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vite.tauri.config.*",
    "vitest.config.*",
    "scripts/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "src/data/**/*",
    "src/core/**/*",
    "src/render/**/*",
    "src/app/**/*",
    "src/tauri/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron-vite/node"],
    "customConditions": ["node"]
  }
}
