{
  "extends": "./tsconfig.base.json",
  "include": [
    "vite.tauri.config.*",
    "vitest.config.*",
    "scripts/**/*",
    "src/preload/**/*",
    "src/data/**/*",
    "src/core/**/*",
    "src/render/**/*",
    "src/app/**/*",
    "src/tauri/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": ["node"],
    "customConditions": ["node"],
    // scripts/*.mts run in plain Node, which needs the .ts extension on an import from src/.
    "rewriteRelativeImportExtensions": true
  }
}
