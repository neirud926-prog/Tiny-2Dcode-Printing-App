{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/preload/*.d.ts",
    "src/core/**/*",
    "src/render/**/*"
  ],
  "exclude": ["src/core/**/*.test.ts", "src/render/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "customConditions": ["browser"]
  }
}
