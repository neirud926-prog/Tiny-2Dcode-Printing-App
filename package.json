{
  "name": "tiny-2dcode-printing-app",
  "version": "0.1.1",
  "private": true,
  "description": "Portable Windows app that prints GS1 DataMatrix labels carrying an Internal GTIN, Expiry and Lot.",
  "main": "./out/main/index.js",
  "author": "Wong Fuk Wing",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev",
    "prestart": "install-electron",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64 --publish never",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:core && npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-vectors": "node scripts/generate-test-vectors.mts"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "^4.11.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zxing-wasm": "^3.1.5"
  }
}
