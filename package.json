{
  "name": "tiny-2dcode-printing-app",
  "version": "0.3.0",
  "private": true,
  "description": "Portable Windows app that prints GS1 DataMatrix labels carrying an Internal GTIN, Expiry and Lot.",
  "author": "Wong Fuk Wing",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "npm run typecheck && vite build --config vite.tauri.config.mts",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run typecheck && tauri build --no-bundle",
    "typecheck:core": "tsc --noEmit -p tsconfig.core.json --composite false",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:tauri": "tsc --noEmit -p tsconfig.tauri.json --composite false",
    "typecheck": "npm run typecheck:core && npm run typecheck:node && npm run typecheck:tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test-vectors": "node scripts/generate-test-vectors.mts"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "bwip-js": "^4.11.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zxing-wasm": "^3.1.5"
  }
}
